---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { getCompanyInfoMap } from '@/lib/repository';
import { aboutImage, companyHistory, leadershipTeam } from '@/lib/site-data';

const companyInfo = await getCompanyInfoMap();
---

<BaseLayout title="Tentang Kami | PT JMK Chemical Solutions" companyInfo={companyInfo}>
  <section class="section-shell grid gap-10 py-20 lg:grid-cols-[0.95fr_1.05fr] lg:items-center">
    <img src={aboutImage} alt="Tim laboratorium dan industri" class="h-full min-h-[320px] w-full rounded-[2rem] object-cover" />
    <div class="space-y-6">
      <SectionHeading
        eyebrow="Profil Perusahaan"
        title={`Tentang ${companyInfo.company_name}`}
        description="Kami adalah perusahaan yang bergerak di bidang distribusi bahan kimia untuk berbagai kebutuhan industri dan bisnis di Indonesia."
      />
      <p class="text-base leading-8 text-slate-600">
        {companyInfo.company_name} hadir untuk menjawab kebutuhan pelanggan akan pasokan bahan kimia yang konsisten, berkualitas, dan aman. Kami melayani sektor manufaktur, laboratorium, agrikultur, hingga pengolahan air dengan pendekatan yang profesional dan solutif.
      </p>
      <div class="grid gap-4 sm:grid-cols-2">
        <div class="card-surface p-6">
          <h3 class="text-lg font-bold text-slate-950">Visi</h3>
          <p class="mt-3 text-sm leading-7 text-slate-600">{companyInfo.vision}</p>
        </div>
        <div class="card-surface p-6">
          <h3 class="text-lg font-bold text-slate-950">Misi</h3>
          <p class="mt-3 text-sm leading-7 text-slate-600">{companyInfo.mission}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-slate-50 py-20">
    <div class="section-shell">
      <SectionHeading
        eyebrow="Perjalanan Kami"
        title="Tumbuh bersama kebutuhan industri Indonesia"
        description="Fokus kami adalah menjadi partner jangka panjang yang siap mendukung operasional pelanggan melalui produk dan layanan yang andal."
      />
      <div class="mt-10 grid gap-6 lg:grid-cols-3">
        {companyHistory.map((item) => (
          <article class="card-surface p-6">
            <p class="text-sm font-semibold text-[var(--color-accent)]">{item.year}</p>
            <h3 class="mt-3 text-xl font-bold text-slate-950">{item.title}</h3>
            <p class="mt-3 text-sm leading-7 text-slate-600">{item.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-shell py-20">
    <SectionHeading
      eyebrow="Tim Inti"
      title="Profesional yang memahami kebutuhan teknis dan operasional pelanggan"
      description="Tim kami menggabungkan pengalaman komersial, teknis, dan operasional untuk memberikan layanan yang cepat dan akurat."
      align="center"
    />
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {leadershipTeam.map((member) => (
        <article class="card-surface p-6">
          <div class="mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-[var(--color-primary)] text-xl font-bold text-white">{member.name.split(' ').map((part) => part[0]).join('')}</div>
          <h3 class="text-xl font-bold text-slate-950">{member.name}</h3>
          <p class="mt-1 text-sm font-semibold text-[var(--color-accent)]">{member.role}</p>
          <p class="mt-3 text-sm leading-7 text-slate-600">{member.description}</p>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
