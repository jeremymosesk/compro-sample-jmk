---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { getCategories, getProducts } from '@/lib/repository';

const [categories, products] = await Promise.all([getCategories(), getProducts()]);
const status = Astro.url.searchParams.get('status');

const statusMessages: Record<string, { text: string; type: 'success' | 'error' | 'warning' }> = {
  created: { text: 'Produk berhasil ditambahkan.', type: 'success' },
  updated: { text: 'Produk berhasil diperbarui.', type: 'success' },
  deleted: { text: 'Produk berhasil dihapus.', type: 'success' },
  'validation-error': { text: 'Mohon lengkapi semua field produk dengan benar.', type: 'warning' },
  'file-too-large': { text: 'Ukuran file terlalu besar! Maksimal ukuran file adalah 2 MB.', type: 'error' },
  'invalid-file-type': { text: 'Format file tidak didukung! Gunakan format PNG, JPG, JPEG, WebP, atau SVG.', type: 'error' },
  'upload-failed': { text: 'Gagal mengunggah file. Silakan coba lagi.', type: 'error' },
  'db-error': { text: 'DATABASE_URL belum dikonfigurasi atau tabel belum tersedia.', type: 'warning' },
};

const currentStatus = status ? statusMessages[status] : null;
---

<AdminLayout title="Kelola Produk | PT JMK Chemical Solutions">
  <div class="space-y-8">
    <div>
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-[var(--color-accent)]">Admin Produk</p>
      <h1 class="mt-2 text-3xl font-bold text-slate-950">Kelola Produk</h1>
      <p class="mt-3 text-sm leading-7 text-slate-600">Tambah, edit, atau hapus katalog produk bahan kimia perusahaan. Mendukung upload file lokal (PNG, JPG, WebP, SVG) atau link URL eksternal.</p>
    </div>

    {currentStatus && (
      <p
        class:list={[
          'rounded-2xl px-4 py-3 text-sm font-medium',
          currentStatus.type === 'success'
            ? 'bg-emerald-50 text-emerald-700 border border-emerald-200'
            : currentStatus.type === 'error'
              ? 'bg-rose-50 text-rose-700 border border-rose-200'
              : 'bg-amber-50 text-amber-700 border border-amber-200',
        ]}
      >
        {currentStatus.text}
      </p>
    )}

    <!-- FORM TAMBAH PRODUK BARU -->
    <section class="card-surface p-6 sm:p-8">
      <h2 class="text-2xl font-bold text-slate-950">Tambah Produk Baru</h2>
      <form
        action="/api/admin/products"
        method="post"
        enctype="multipart/form-data"
        class="mt-6 grid gap-6 md:grid-cols-2"
      >
        <input type="hidden" name="action" value="create" />

        <label class="text-sm font-semibold text-slate-700">
          Nama Produk *
          <input
            name="name"
            placeholder="Contoh: Asam Sulfat 98%"
            required
            class="mt-2 w-full rounded-2xl border border-slate-300 px-4 py-3 font-normal outline-none transition focus:border-[var(--color-primary)]"
          />
        </label>

        <label class="text-sm font-semibold text-slate-700">
          Slug (opsional)
          <input
            name="slug"
            placeholder="otomatis dibuat jika dikosongkan"
            class="mt-2 w-full rounded-2xl border border-slate-300 px-4 py-3 font-normal outline-none transition focus:border-[var(--color-primary)]"
          />
        </label>

        <label class="text-sm font-semibold text-slate-700">
          Kategori *
          <select
            name="category"
            required
            class="mt-2 w-full rounded-2xl border border-slate-300 px-4 py-3 font-normal outline-none transition focus:border-[var(--color-primary)]"
          >
            {categories.map((category) => (
              <option value={category.name}>{category.name}</option>
            ))}
          </select>
        </label>

        <label class="text-sm font-semibold text-slate-700">
          Produk Unggulan
          <select
            name="isFeatured"
            class="mt-2 w-full rounded-2xl border border-slate-300 px-4 py-3 font-normal outline-none transition focus:border-[var(--color-primary)]"
          >
            <option value="false">Tidak</option>
            <option value="true">Ya (Tampil di Beranda)</option>
          </select>
        </label>

        <!-- INPUT GAMBAR: DUAL (UPLOAD ATAU URL) -->
        <div class="md:col-span-2 rounded-2xl border border-slate-200 bg-slate-50/70 p-5 space-y-4">
          <p class="text-sm font-bold text-slate-900">Gambar Produk *</p>
          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label class="text-xs font-semibold text-slate-600 block mb-1.5">
                Opsi 1: Upload File Gambar (Maks. 2MB: PNG, JPG, WebP, SVG)
              </label>
              <input
                type="file"
                name="imageFile"
                id="create-product-file"
                accept=".png,.jpg,.jpeg,.webp,.svg,.gif"
                class="w-full text-sm text-slate-500 file:mr-4 file:py-2.5 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-[var(--color-primary)] file:text-white hover:file:bg-[var(--color-primary)]/90 cursor-pointer"
              />
            </div>

            <div>
              <label class="text-xs font-semibold text-slate-600 block mb-1.5">
                Opsi 2: Atau Masukkan Link URL Gambar
              </label>
              <input
                name="imageUrl"
                id="create-product-url"
                placeholder="https://images.unsplash.com/... atau /uploads/..."
                class="w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2.5 text-sm font-normal outline-none transition focus:border-[var(--color-primary)]"
              />
            </div>
          </div>

          <!-- LIVE PREVIEW CONTAINER -->
          <div class="flex items-center gap-3 pt-2">
            <span class="text-xs text-slate-500">Preview:</span>
            <div class="h-20 w-28 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm flex items-center justify-center">
              <img
                id="create-product-preview"
                src=""
                alt="Preview gambar"
                class="h-full w-full object-cover hidden"
              />
              <span id="create-product-empty" class="text-[11px] text-slate-400">Belum ada</span>
            </div>
          </div>
        </div>

        <label class="text-sm font-semibold text-slate-700 md:col-span-2">
          Deskripsi Produk *
          <textarea
            name="description"
            rows="4"
            required
            placeholder="Deskripsi spesifikasi, aplikasi, dan keunggulan bahan kimia ini..."
            class="mt-2 w-full rounded-2xl border border-slate-300 px-4 py-3 font-normal outline-none transition focus:border-[var(--color-primary)]"
          ></textarea>
        </label>

        <div class="md:col-span-2 flex justify-end">
          <button type="submit" class="btn-primary">Simpan Produk Baru</button>
        </div>
      </form>
    </section>

    <!-- DAFTAR & EDIT PRODUK -->
    <section class="space-y-6">
      <h2 class="text-xl font-bold text-slate-900">Daftar Produk ({products.length})</h2>
      {products.map((product) => (
        <article class="card-surface p-6 sm:p-8">
          <div class="flex flex-col gap-6 xl:flex-row xl:items-start xl:justify-between">
            <form
              action="/api/admin/products"
              method="post"
              enctype="multipart/form-data"
              class="grid flex-1 gap-5 md:grid-cols-2"
            >
              <input type="hidden" name="action" value="update" />
              <input type="hidden" name="id" value={product.id} />

              <label class="text-sm font-semibold text-slate-700">
                Nama Produk
                <input
                  name="name"
                  value={product.name}
                  required
                  class="mt-2 w-full rounded-2xl border border-slate-300 px-4 py-3 font-normal outline-none transition focus:border-[var(--color-primary)]"
                />
              </label>

              <label class="text-sm font-semibold text-slate-700">
                Slug
                <input
                  name="slug"
                  value={product.slug}
                  required
                  class="mt-2 w-full rounded-2xl border border-slate-300 px-4 py-3 font-normal outline-none transition focus:border-[var(--color-primary)]"
                />
              </label>

              <label class="text-sm font-semibold text-slate-700">
                Kategori
                <select
                  name="category"
                  class="mt-2 w-full rounded-2xl border border-slate-300 px-4 py-3 font-normal outline-none transition focus:border-[var(--color-primary)]"
                >
                  {categories.map((category) => (
                    <option
                      value={category.name}
                      selected={category.name === product.category}
                    >
                      {category.name}
                    </option>
                  ))}
                </select>
              </label>

              <label class="text-sm font-semibold text-slate-700">
                Produk Unggulan
                <select
                  name="isFeatured"
                  class="mt-2 w-full rounded-2xl border border-slate-300 px-4 py-3 font-normal outline-none transition focus:border-[var(--color-primary)]"
                >
                  <option value="true" selected={product.isFeatured}>Ya</option>
                  <option value="false" selected={!product.isFeatured}>Tidak</option>
                </select>
              </label>

              <!-- UPLOAD & URL UNTUK UPDATE -->
              <div class="md:col-span-2 rounded-2xl border border-slate-200 bg-slate-50/70 p-4 space-y-3">
                <div class="flex flex-col gap-4 sm:flex-row sm:items-center">
                  <!-- Thumbnail Gambar Saat Ini -->
                  <div class="shrink-0">
                    <p class="text-xs text-slate-500 mb-1">Gambar Saat Ini:</p>
                    <div class="h-20 w-28 overflow-hidden rounded-xl border border-slate-300 bg-white shadow-sm flex items-center justify-center">
                      <img
                        id={`edit-preview-${product.id}`}
                        src={product.imageUrl}
                        alt={product.name}
                        class="h-full w-full object-cover"
                      />
                    </div>
                  </div>

                  <!-- Ganti Gambar -->
                  <div class="flex-1 space-y-3">
                    <div>
                      <label class="text-xs font-semibold text-slate-700 block mb-1">
                        Ganti File (Maks. 2MB: PNG, JPG, WebP, SVG):
                      </label>
                      <input
                        type="file"
                        name="imageFile"
                        accept=".png,.jpg,.jpeg,.webp,.svg,.gif"
                        data-preview-target={`edit-preview-${product.id}`}
                        class="product-edit-file w-full text-xs text-slate-500 file:mr-3 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-slate-800 file:text-white hover:file:bg-slate-700 cursor-pointer"
                      />
                    </div>
                    <div>
                      <label class="text-xs font-semibold text-slate-700 block mb-1">
                        Atau Ubah Link URL Gambar:
                      </label>
                      <input
                        name="imageUrl"
                        value={product.imageUrl}
                        data-preview-target={`edit-preview-${product.id}`}
                        class="product-edit-url w-full rounded-xl border border-slate-300 bg-white px-3 py-1.5 text-xs font-normal outline-none transition focus:border-[var(--color-primary)]"
                      />
                    </div>
                  </div>
                </div>
              </div>

              <label class="text-sm font-semibold text-slate-700 md:col-span-2">
                Deskripsi
                <textarea
                  name="description"
                  rows="4"
                  required
                  class="mt-2 w-full rounded-2xl border border-slate-300 px-4 py-3 font-normal outline-none transition focus:border-[var(--color-primary)]"
                >{product.description}</textarea>
              </label>

              <div class="flex items-end">
                <button type="submit" class="btn-primary">Update Produk</button>
              </div>
            </form>

            <form
              action="/api/admin/products"
              method="post"
              class="xl:w-[160px]"
              onsubmit="return confirm('Apakah Anda yakin ingin menghapus produk ini?');"
            >
              <input type="hidden" name="action" value="delete" />
              <input type="hidden" name="id" value={product.id} />
              <button
                type="submit"
                class="w-full rounded-full bg-rose-600 px-5 py-3 text-sm font-semibold text-white transition hover:bg-rose-700"
              >
                Hapus
              </button>
            </form>
          </div>
        </article>
      ))}
    </section>
  </div>

  <script>
    // Create preview handlers
    const createFile = document.getElementById('create-product-file') as HTMLInputElement | null;
    const createUrl = document.getElementById('create-product-url') as HTMLInputElement | null;
    const createPreview = document.getElementById('create-product-preview') as HTMLImageElement | null;
    const createEmpty = document.getElementById('create-product-empty') as HTMLElement | null;

    if (createFile && createPreview && createEmpty) {
      createFile.addEventListener('change', () => {
        const file = createFile.files?.[0];
        if (file) {
          if (file.size > 2 * 1024 * 1024) {
            alert('Ukuran file melebihi 2MB!');
            createFile.value = '';
            return;
          }
          createPreview.src = URL.createObjectURL(file);
          createPreview.classList.remove('hidden');
          createEmpty.classList.add('hidden');
        }
      });
    }

    if (createUrl && createPreview && createEmpty) {
      createUrl.addEventListener('input', () => {
        const val = createUrl.value.trim();
        if (val) {
          createPreview.src = val;
          createPreview.classList.remove('hidden');
          createEmpty.classList.add('hidden');
        }
      });
    }

    // Edit preview handlers
    document.querySelectorAll<HTMLInputElement>('.product-edit-file').forEach((input) => {
      input.addEventListener('change', () => {
        const targetId = input.getAttribute('data-preview-target');
        const previewEl = targetId ? (document.getElementById(targetId) as HTMLImageElement | null) : null;
        const file = input.files?.[0];
        if (file && previewEl) {
          if (file.size > 2 * 1024 * 1024) {
            alert('Ukuran file melebihi 2MB!');
            input.value = '';
            return;
          }
          previewEl.src = URL.createObjectURL(file);
        }
      });
    });

    document.querySelectorAll<HTMLInputElement>('.product-edit-url').forEach((input) => {
      input.addEventListener('input', () => {
        const targetId = input.getAttribute('data-preview-target');
        const previewEl = targetId ? (document.getElementById(targetId) as HTMLImageElement | null) : null;
        const val = input.value.trim();
        if (val && previewEl) {
          previewEl.src = val;
        }
      });
    });
  </script>
</AdminLayout>
