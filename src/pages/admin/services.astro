---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { getServices } from '@/lib/repository';

const services = await getServices();
const status = Astro.url.searchParams.get('status');

const statusMessage =
  status === 'created'
    ? 'Layanan berhasil ditambahkan.'
    : status === 'updated'
      ? 'Layanan berhasil diperbarui.'
      : status === 'deleted'
        ? 'Layanan berhasil dihapus.'
        : status === 'validation-error'
          ? 'Mohon lengkapi semua field layanan dengan benar.'
          : status === 'db-error'
            ? 'DATABASE_URL belum dikonfigurasi atau tabel belum tersedia.'
            : null;
---

<AdminLayout title="Kelola Layanan | PT JMK Chemical Solutions">
  <div class="space-y-8">
    <div>
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-[var(--color-accent)]">Admin Layanan</p>
      <h1 class="mt-2 text-3xl font-bold text-slate-950">Kelola Layanan</h1>
      <p class="mt-3 text-sm leading-7 text-slate-600">Perbarui daftar layanan yang ditawarkan perusahaan.</p>
    </div>

    {statusMessage && <p class:list={['rounded-2xl px-4 py-3 text-sm', ['created', 'updated', 'deleted'].includes(status ?? '') ? 'bg-emerald-50 text-emerald-700' : 'bg-amber-50 text-amber-700']}>{statusMessage}</p>}

    <section class="card-surface p-6 sm:p-8">
      <h2 class="text-2xl font-bold text-slate-950">Tambah Layanan Baru</h2>
      <form action="/api/admin/services" method="post" class="mt-6 grid gap-5 md:grid-cols-2">
        <input type="hidden" name="action" value="create" />
        <label class="text-sm font-semibold text-slate-700">Nama Layanan<input name="name" required class="mt-2 w-full rounded-2xl border border-slate-300 px-4 py-3 font-normal outline-none transition focus:border-[var(--color-primary)]" /></label>
        <label class="text-sm font-semibold text-slate-700">Ikon (emoji / teks singkat)<input name="icon" required class="mt-2 w-full rounded-2xl border border-slate-300 px-4 py-3 font-normal outline-none transition focus:border-[var(--color-primary)]" /></label>
        <label class="text-sm font-semibold text-slate-700 md:col-span-2">Deskripsi<textarea name="description" rows="4" required class="mt-2 w-full rounded-2xl border border-slate-300 px-4 py-3 font-normal outline-none transition focus:border-[var(--color-primary)]"></textarea></label>
        <div><button type="submit" class="btn-primary">Simpan Layanan</button></div>
      </form>
    </section>

    <section class="space-y-6">
      {services.map((service) => (
        <article class="card-surface p-6 sm:p-8">
          <div class="flex flex-col gap-6 xl:flex-row xl:items-start xl:justify-between">
            <form action="/api/admin/services" method="post" class="grid flex-1 gap-5 md:grid-cols-2">
              <input type="hidden" name="action" value="update" />
              <input type="hidden" name="id" value={service.id} />
              <label class="text-sm font-semibold text-slate-700">Nama Layanan<input name="name" value={service.name} required class="mt-2 w-full rounded-2xl border border-slate-300 px-4 py-3 font-normal outline-none transition focus:border-[var(--color-primary)]" /></label>
              <label class="text-sm font-semibold text-slate-700">Ikon<input name="icon" value={service.icon} required class="mt-2 w-full rounded-2xl border border-slate-300 px-4 py-3 font-normal outline-none transition focus:border-[var(--color-primary)]" /></label>
              <label class="text-sm font-semibold text-slate-700 md:col-span-2">Deskripsi<textarea name="description" rows="4" required class="mt-2 w-full rounded-2xl border border-slate-300 px-4 py-3 font-normal outline-none transition focus:border-[var(--color-primary)]">{service.description}</textarea></label>
              <div><button type="submit" class="btn-primary">Update Layanan</button></div>
            </form>
            <form action="/api/admin/services" method="post" class="xl:w-[160px]">
              <input type="hidden" name="action" value="delete" />
              <input type="hidden" name="id" value={service.id} />
              <button type="submit" class="w-full rounded-full bg-rose-600 px-5 py-3 text-sm font-semibold text-white transition hover:bg-rose-700">Hapus</button>
            </form>
          </div>
        </article>
      ))}
    </section>
  </div>
</AdminLayout>
