---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { getCompanyInfoMap, getProducts, getServices } from '@/lib/repository';
import { seededCompanyInfo } from '@/lib/site-data';
import { db } from '@/db';

const [companyInfo, products, services] = await Promise.all([getCompanyInfoMap(), getProducts(), getServices()]);
const status = Astro.url.searchParams.get('status');
const companyFields = seededCompanyInfo.map((item) => item.key);
const statusMessage =
  status === 'company-updated'
    ? 'Informasi perusahaan berhasil diperbarui.'
    : status === 'db-error'
      ? 'DATABASE_URL belum dikonfigurasi atau migrasi belum dijalankan.'
      : null;
---

<AdminLayout title="Dashboard Admin | PT JMK Chemical Solutions">
  <div class="space-y-8">
    <div>
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-[var(--color-accent)]">Dashboard</p>
      <h1 class="mt-2 text-3xl font-bold text-slate-950">Ringkasan Admin</h1>
      <p class="mt-3 text-sm leading-7 text-slate-600">Kelola konten company profile secara langsung melalui panel admin berbasis Astro SSR.</p>
    </div>

    <div class="grid gap-6 md:grid-cols-3">
      <div class="card-surface p-6">
        <p class="text-sm text-slate-500">Total Produk</p>
        <p class="mt-2 text-3xl font-bold text-slate-950">{products.length}</p>
      </div>
      <div class="card-surface p-6">
        <p class="text-sm text-slate-500">Total Layanan</p>
        <p class="mt-2 text-3xl font-bold text-slate-950">{services.length}</p>
      </div>
      <div class="card-surface p-6">
        <p class="text-sm text-slate-500">Status Database</p>
        <p class="mt-2 text-lg font-bold text-slate-950">{db ? 'Siap digunakan' : 'Belum dikonfigurasi'}</p>
      </div>
    </div>

    <section class="card-surface p-6 sm:p-8">
      <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <h2 class="text-2xl font-bold text-slate-950">Kelola Informasi Perusahaan</h2>
          <p class="mt-2 text-sm leading-7 text-slate-600">Perbarui data utama perusahaan yang digunakan pada header, footer, dan halaman publik.</p>
        </div>
      </div>

      {statusMessage && <p class:list={['mt-5 rounded-2xl px-4 py-3 text-sm', status === 'company-updated' ? 'bg-emerald-50 text-emerald-700' : 'bg-amber-50 text-amber-700']}>{statusMessage}</p>}

      <form action="/api/admin/company-info" method="post" class="mt-6 grid gap-5 md:grid-cols-2">
        {companyFields.map((field) => (
          <label class="text-sm font-semibold text-slate-700">
            <span class="mb-2 block capitalize">{field.replaceAll('_', ' ')}</span>
            {field === 'vision' || field === 'mission' || field === 'tagline' || field === 'address' ? (
              <textarea name={field} rows="4" class="w-full rounded-2xl border border-slate-300 px-4 py-3 font-normal outline-none transition focus:border-[var(--color-primary)]">{companyInfo[field]}</textarea>
            ) : (
              <input name={field} value={companyInfo[field]} class="w-full rounded-2xl border border-slate-300 px-4 py-3 font-normal outline-none transition focus:border-[var(--color-primary)]" />
            )}
          </label>
        ))}
        <div class="md:col-span-2">
          <button type="submit" class="btn-primary">Simpan Informasi Perusahaan</button>
        </div>
      </form>
    </section>
  </div>
</AdminLayout>
