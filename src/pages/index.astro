---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import ProductCard from '@/components/ProductCard.astro';
import { getCompanyInfoMap, getFeaturedProducts, getServices } from '@/lib/repository';
import { heroImage, whyChooseUs } from '@/lib/site-data';

const [companyInfo, featuredProducts, services] = await Promise.all([
  getCompanyInfoMap(),
  getFeaturedProducts(4),
  getServices(),
]);
---

<BaseLayout title="PT JMK Chemical Solutions | Beranda" companyInfo={companyInfo}>
  <section class="bg-slate-950 text-white">
    <div class="section-shell grid gap-10 py-20 lg:grid-cols-[1.05fr_0.95fr] lg:items-center">
      <div class="space-y-6">
        <span class="inline-flex rounded-full border border-white/20 px-4 py-2 text-sm text-slate-200">Solusi Bahan Kimia untuk Industri Modern</span>
        <h1 class="text-4xl font-extrabold leading-tight sm:text-5xl">{companyInfo.tagline}</h1>
        <p class="max-w-2xl text-lg leading-8 text-slate-300">
          Kami membantu perusahaan Anda mendapatkan pasokan bahan kimia yang aman, konsisten, dan siap mendukung kebutuhan operasional jangka panjang.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="/products" class="btn-accent">Lihat Produk</a>
          <a href="/contact" class="btn-primary">Konsultasi Sekarang</a>
        </div>
      </div>

      <img src={heroImage} alt="Fasilitas laboratorium modern" class="h-full min-h-[320px] w-full rounded-[2rem] object-cover shadow-2xl" />
    </div>
  </section>

  <section class="section-shell py-20">
    <SectionHeading
      eyebrow="Produk Unggulan"
      title="Portofolio bahan kimia yang siap menunjang bisnis Anda"
      description="Kami menyiapkan produk unggulan untuk kebutuhan industri, laboratorium, pertanian, dan water treatment dengan dukungan pengadaan yang responsif."
    />

    <div class="mt-10 grid gap-6 md:grid-cols-2 xl:grid-cols-4">
      {featuredProducts.map((product) => <ProductCard product={product} />)}
    </div>
  </section>

  <section class="bg-slate-50 py-20">
    <div class="section-shell grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
      <SectionHeading
        eyebrow="Mengapa Memilih Kami"
        title="Partner B2B yang fokus pada kualitas, kecepatan, dan kepastian pasokan"
        description="Kami memahami bahwa stabilitas pasokan bahan kimia sangat penting bagi keberlangsungan operasi pelanggan."
      />

      <div class="grid gap-4 sm:grid-cols-2">
        {whyChooseUs.map((reason) => (
          <div class="card-surface p-6 text-sm leading-7 text-slate-600">{reason}</div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-shell py-20">
    <SectionHeading
      eyebrow="Layanan Kami"
      title="Lebih dari sekadar distributor bahan kimia"
      description="PT JMK Chemical Solutions hadir dengan layanan yang membantu tim pengadaan, operasional, dan teknis pelanggan bekerja lebih efektif."
      align="center"
    />

    <div class="mt-10 grid gap-6 md:grid-cols-2 xl:grid-cols-4">
      {services.map((service) => (
        <article class="card-surface p-6">
          <div class="mb-4 text-4xl">{service.icon}</div>
          <h3 class="text-xl font-bold text-slate-950">{service.name}</h3>
          <p class="mt-3 text-sm leading-7 text-slate-600">{service.description}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="bg-[var(--color-primary)] py-20 text-white">
    <div class="section-shell flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
      <div class="max-w-3xl space-y-3">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-amber-300">Siap Melayani Kebutuhan Anda</p>
        <h2 class="text-3xl font-bold sm:text-4xl">Diskusikan kebutuhan bahan kimia perusahaan Anda bersama tim kami.</h2>
      </div>
      <a href="/contact" class="btn-accent">Minta Penawaran</a>
    </div>
  </section>
</BaseLayout>
