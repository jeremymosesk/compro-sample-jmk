---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import ProductCard from '@/components/ProductCard.astro';
import { getCategories, getCompanyInfoMap, getProducts } from '@/lib/repository';

const [companyInfo, categories, products] = await Promise.all([getCompanyInfoMap(), getCategories(), getProducts()]);
const status = Astro.url.searchParams.get('status');
---

<BaseLayout title="Produk | PT JMK Chemical Solutions" companyInfo={companyInfo}>
  <section class="bg-slate-50 py-20">
    <div class="section-shell">
      <SectionHeading
        eyebrow="Produk Kami"
        title="Katalog bahan kimia untuk berbagai kebutuhan industri"
        description="Jelajahi kategori produk yang kami sediakan untuk mendukung kebutuhan operasional perusahaan, laboratorium, pertanian, dan pengolahan air."
      />
    </div>
  </section>

  <section class="section-shell py-20">
    {status === 'not-found' && <p class="mb-8 rounded-2xl bg-amber-50 px-4 py-3 text-sm text-amber-700">Produk yang Anda cari tidak ditemukan.</p>}
    <div class="space-y-16">
      {categories.map((category) => {
        const groupedProducts = products.filter((product) => product.category === category.name);
        return (
          <section id={category.slug} class="space-y-8">
            <div class="flex flex-col gap-3 border-b border-slate-200 pb-6 sm:flex-row sm:items-end sm:justify-between">
              <div>
                <p class="text-sm font-semibold uppercase tracking-[0.2em] text-[var(--color-accent)]">Kategori</p>
                <h2 class="text-3xl font-bold text-slate-950">{category.name}</h2>
              </div>
              <p class="text-sm text-slate-500">{groupedProducts.length} produk tersedia</p>
            </div>
            <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
              {groupedProducts.map((product) => <ProductCard product={product} />)}
            </div>
          </section>
        );
      })}
    </div>
  </section>
</BaseLayout>
