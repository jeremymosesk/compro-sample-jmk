---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCompanyInfoMap, getProductBySlug } from '@/lib/repository';

const slug = Astro.params.slug ?? '';
const [companyInfo, product] = await Promise.all([getCompanyInfoMap(), getProductBySlug(slug)]);

if (!product) {
  return Astro.redirect('/products?status=not-found');
}
---

<BaseLayout
  title={`${product.name} | PT JMK Chemical Solutions`}
  companyInfo={companyInfo}
>
  <section class="section-shell grid gap-10 py-20 lg:grid-cols-[1fr_1fr] lg:items-start">
    <div class="aspect-[4/3] max-h-[500px] w-full overflow-hidden rounded-[2rem] bg-slate-100 border border-slate-200/80 shadow-md">
      <img src={product.imageUrl} alt={product.name} class="h-full w-full object-cover" />
    </div>
    <div class="space-y-6">
      <span class="inline-flex rounded-full bg-amber-100 px-4 py-2 text-sm font-semibold text-amber-700">{product.category}</span>
      <h1 class="text-4xl font-bold text-slate-950">{product.name}</h1>
      <p class="text-lg leading-8 text-slate-600">{product.description}</p>
      <div class="card-surface p-6">
        <h2 class="text-lg font-bold text-slate-950">Mengapa memilih produk ini?</h2>
        <ul class="mt-4 space-y-3 text-sm leading-7 text-slate-600">
          <li>• Tersedia untuk kebutuhan pasokan rutin maupun proyek khusus.</li>
          <li>• Didukung tim responsif untuk konsultasi spesifikasi produk.</li>
          <li>• Cocok untuk pelanggan yang membutuhkan mitra pengadaan jangka panjang.</li>
        </ul>
      </div>
      <div class="flex flex-wrap gap-4">
        <a href="/contact" class="btn-accent">Tanyakan Produk Ini</a>
        <a href="/products" class="btn-primary">Kembali ke Produk</a>
      </div>
    </div>
  </section>
</BaseLayout>
