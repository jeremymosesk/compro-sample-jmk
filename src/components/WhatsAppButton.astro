---
import { getWhatsAppLink } from '@/lib/utils';
import { whatsappNumber as defaultWhatsappNumber } from '@/lib/site-data';

interface Props {
  whatsappNumber?: string;
}

const { whatsappNumber = defaultWhatsappNumber } = Astro.props;
---

<a
  href={getWhatsAppLink(whatsappNumber || defaultWhatsappNumber)}
  target="_blank"
  rel="noreferrer"
  aria-label="Hubungi kami melalui WhatsApp"
  class="fixed bottom-6 right-6 z-50 inline-flex h-14 w-14 items-center justify-center rounded-full bg-[#25d366] text-2xl text-white shadow-lg transition hover:scale-105"
>
  💬
</a>
