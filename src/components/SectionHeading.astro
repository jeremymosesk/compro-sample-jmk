---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
}

const { eyebrow, title, description, align = 'left' } = Astro.props;
---

<div class:list={['space-y-3', align === 'center' ? 'text-center' : 'text-left']}>
  {eyebrow && <p class="text-sm font-semibold uppercase tracking-[0.2em] text-[var(--color-accent)]">{eyebrow}</p>}
  <h2 class="text-3xl font-bold text-slate-950 sm:text-4xl">{title}</h2>
  {description && <p class:list={['text-base leading-8 text-slate-600', align === 'center' ? 'mx-auto max-w-3xl' : 'max-w-3xl']}>{description}</p>}
</div>
