---
const currentPath = Astro.url.pathname;
const links = [
  { href: '/', label: 'Beranda' },
  { href: '/about', label: 'Tentang' },
  { href: '/products', label: 'Produk' },
  { href: '/services', label: 'Layanan' },
  { href: '/contact', label: 'Kontak' },
];
---

<header class="sticky top-0 z-40 border-b border-slate-200 bg-white/95 backdrop-blur">
  <div class="section-shell flex items-center justify-between gap-4 py-4">
    <a href="/" class="flex items-center gap-3 text-sm font-bold text-[var(--color-primary)] sm:text-base">
      <span class="flex h-11 w-11 items-center justify-center rounded-2xl bg-[var(--color-primary)] text-lg text-white">JMK</span>
      <span>PT JMK Chemical Solutions</span>
    </a>

    <nav class="hidden items-center gap-6 md:flex">
      {links.map((link) => (
        <a
          href={link.href}
          class:list={[
            'text-sm font-medium transition hover:text-[var(--color-accent)]',
            currentPath === link.href ? 'text-[var(--color-primary)]' : 'text-slate-600',
          ]}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <a href="/contact" class="btn-accent hidden md:inline-flex">Hubungi Kami</a>
  </div>

  <div class="section-shell flex gap-3 overflow-x-auto pb-4 md:hidden">
    {links.map((link) => (
      <a
        href={link.href}
        class:list={[
          'whitespace-nowrap rounded-full px-4 py-2 text-sm font-medium',
          currentPath === link.href ? 'bg-[var(--color-primary)] text-white' : 'bg-slate-100 text-slate-700',
        ]}
      >
        {link.label}
      </a>
    ))}
  </div>
</header>
