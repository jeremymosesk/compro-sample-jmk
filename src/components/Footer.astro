---
import { getWhatsAppLink } from '@/lib/utils';

interface Props {
  companyInfo: Record<string, string>;
}

const { companyInfo } = Astro.props;
const quickLinks = [
  { href: '/', label: 'Beranda' },
  { href: '/about', label: 'Tentang Kami' },
  { href: '/products', label: 'Produk' },
  { href: '/services', label: 'Layanan' },
  { href: '/contact', label: 'Kontak' },
];
---

<footer class="border-t border-slate-200 bg-slate-950 text-slate-200">
  <div class="section-shell grid gap-10 py-14 md:grid-cols-[1.2fr_0.8fr_1fr]">
    <div class="space-y-4">
      <h2 class="text-2xl font-bold text-white">{companyInfo.company_name}</h2>
      <p class="max-w-xl text-sm leading-7 text-slate-300">{companyInfo.tagline}</p>
      <a href={getWhatsAppLink(companyInfo.whatsapp)} target="_blank" rel="noreferrer" class="btn-accent">Chat WhatsApp</a>
    </div>

    <div>
      <h3 class="mb-4 text-lg font-semibold text-white">Tautan Cepat</h3>
      <ul class="space-y-3 text-sm text-slate-300">
        {quickLinks.map((link) => (
          <li><a href={link.href} class="transition hover:text-[var(--color-accent)]">{link.label}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <h3 class="mb-4 text-lg font-semibold text-white">Kontak</h3>
      <ul class="space-y-3 text-sm leading-7 text-slate-300">
        <li>{companyInfo.address}</li>
        <li>{companyInfo.phone}</li>
        <li>{companyInfo.email}</li>
      </ul>
    </div>
  </div>
</footer>
