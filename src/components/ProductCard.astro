---
interface Product {
  name: string;
  slug: string;
  description: string;
  category: string;
  imageUrl: string;
}

const { product } = Astro.props as { product: Product };
---

<article class="card-surface overflow-hidden">
  <img src={product.imageUrl} alt={product.name} class="h-56 w-full object-cover" loading="lazy" />
  <div class="space-y-4 p-6">
    <span class="inline-flex rounded-full bg-amber-100 px-3 py-1 text-xs font-semibold text-amber-700">{product.category}</span>
    <h3 class="text-xl font-bold text-slate-950">{product.name}</h3>
    <p class="text-sm leading-7 text-slate-600">{product.description}</p>
    <a href={`/products/${product.slug}`} class="inline-flex font-semibold text-[var(--color-primary)] transition hover:text-[var(--color-accent)]">Lihat detail →</a>
  </div>
</article>
