---
interface Product {
  name: string;
  slug: string;
  description: string;
  category: string;
  imageUrl: string;
}

const { product } = Astro.props as { product: Product };
---

<article class="card-surface group overflow-hidden flex flex-col justify-between">
  <div>
    <div class="aspect-[4/3] w-full bg-slate-100 overflow-hidden relative flex items-center justify-center">
      <img
        src={product.imageUrl}
        alt={product.name}
        class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
        loading="lazy"
      />
    </div>
    <div class="space-y-3 p-6">
      <span class="inline-flex rounded-full bg-amber-100 px-3 py-1 text-xs font-semibold text-amber-700">{product.category}</span>
      <h3 class="text-xl font-bold text-slate-950 transition-colors group-hover:text-[var(--color-primary)]">{product.name}</h3>
      <p class="text-sm leading-7 text-slate-600 line-clamp-3">{product.description}</p>
    </div>
  </div>
  <div class="px-6 pb-6 pt-0">
    <a href={`/products/${product.slug}`} class="inline-flex items-center gap-1 text-sm font-semibold text-[var(--color-primary)] transition hover:text-[var(--color-accent)]">
      Lihat detail <span>→</span>
    </a>
  </div>
</article>
