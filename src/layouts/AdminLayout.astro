---
import '@/styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
const currentPath = Astro.url.pathname;
const links = [
  { href: '/admin', label: 'Dashboard' },
  { href: '/admin/products', label: 'Kelola Produk' },
  { href: '/admin/services', label: 'Kelola Layanan' },
];
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-slate-100">
    <div class="min-h-screen lg:grid lg:grid-cols-[280px_1fr]">
      <aside class="bg-[var(--color-primary)] p-6 text-white">
        <a href="/admin" class="mb-10 inline-flex text-lg font-bold">Panel Admin JMK</a>
        <nav class="space-y-2">
          {links.map((link) => (
            <a
              href={link.href}
              class:list={[
                'block rounded-2xl px-4 py-3 text-sm font-medium transition',
                currentPath === link.href ? 'bg-white text-[var(--color-primary)]' : 'text-slate-100 hover:bg-white/10',
              ]}
            >
              {link.label}
            </a>
          ))}
        </nav>
        <form action="/api/admin/logout" method="post" class="mt-10">
          <button type="submit" class="w-full rounded-2xl border border-white/40 px-4 py-3 text-sm font-semibold transition hover:bg-white/10">Logout</button>
        </form>
      </aside>

      <main class="p-6 sm:p-8">
        <slot />
      </main>
    </div>
  </body>
</html>
